{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path__=api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index?__path__=health"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__path__=$1"
    }
  ]
}
